                                   mesh.transform ),
         .triangles       = range->indexCount / 3,
+        .cell            = StableCell( &dynamicStorage.vertices[ range->firstVertex ], range->vertexCount, mesh.transform ),
     } );
     frameGeomCount++;
     return true;
